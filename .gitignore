
# day la comment, khong co tac dung ignore files/folders
# alo  alo/ => git khong theo doi thu muc alo
alo

# chung ta se bo qua tat ca cac file co duoi la .log
*.log


# muon bo qua file abc.xyz nhung van giu myfile.xyz
# se chi bo qua cac file .xyz o trong git repo
/*.xyz


# bo qua file abc.txt trong folder second_folder
# Ubuntu thi su dung /  la path seperator
# Windows thi su dung // hoac \
second_folder/abc.txt